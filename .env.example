POSTGRES_DB=YOUR_VALUE_HERE
POSTGRES_USER=YOUR_VALUE_HERE
POSTGRES_PASSWORD=YOUR_VALUE_HERE



# ── Redis ───────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Google ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_VALUE_HERE
GOOGLE_CLIENT_SECRET=YOUR_VALUE_HERE

# ── Github ───────────────────────────────────────────────────────
GITHUB_CLIENT_ID=YOUR_VALUE_HERE
GITHUB_CLIENT_SECRET=YOUR_VALUE_HERE

# ── SMTP (GMAIL) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_VALUE_HERE
SMTP_PASSWORD=YOUR_VALUE_HERE

MAIL_HOST=YOUR_VALUE_HERE
MAIL_PORT=YOUR_VALUE_HERE
MAIL_USERNAME=YOUR_VALUE_HERE
MAIL_PASSWORD=YOUR_VALUE_HERE

MAIL_FROM=YOUR_VALUE_HERE
BREVO_API_KEY=YOUR_VALUE_HERE
BREVO_TEMPLATE_ORDER_CONFIRMATION=1
BREVO_TEMPLATE_PAYMENT_SUCCESS=2
BREVO_TEMPLATE_ABANDONED_CART=3
BREVO_TEMPLATE_ADMIN_BROADCAST=4
BREVO_TEMPLATE_ORDER_SHIPPED=5

# Background mail jobs. Leave false to keep both dormant.
# Setting this to true activates two schedulers that have never run before and
# start immediately:
#   AbandonedCartScheduler - hourly, enqueues abandoned-cart reminder emails
#   EmailRetryScheduler    - every 60s, retries queued emails Brevo failed to deliver
# Emails are delivered for real, so opt in per environment on purpose.
MAIL_SCHEDULING_ENABLED=false

# ── Frontend URL ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# ── Cloudinary ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=YOUR_VALUE_HERE
CLOUDINARY_API_KEY=YOUR_VALUE_HERE
CLOUDINARY_API_SECRET=YOUR_VALUE_HERE

PAYMOB_API_KEY=YOUR_VALUE_HERE
PAYMOB_HMAC_SECRET=YOUR_VALUE_HERE
PAYMOB_INTEGRATION_ID=YOUR_VALUE_HERE
PAYMOB_IFRAME_ID=YOUR_VALUE_HERE

# AI features (all default false; enable after indexing the catalog)
AI_ENABLED=false
AI_SEARCH_ENABLED=false
AI_CHATBOT_ENABLED=false

# Embeddings always run on local Ollama - semantic search must not need an
# external service or a quota, and it runs on the index path.
OLLAMA_BASE_URL=http://localhost:11434

# Chat model. Leave GROQ_API_KEY blank and the assistant runs entirely on local
# Ollama (AI_LOCAL_CHAT_MODEL below): zero configuration, no API key, no network.
# Set it and the chat model moves to Groq instead. The embedding model stays
# local either way.
GROQ_API_KEY=
# Must include /v1 — Groq's OpenAI-compatible API lives under /openai/v1.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Must be a NON-reasoning model. The gpt-oss-* models return reasoning_content on every
# assistant turn; Spring AI replays that turn inside the tool-calling loop and Groq rejects
# it with 400, so every tool-backed question answers with the failure apology instead of a
# recommendation. Startup now rejects a reasoning model outright. On Groq's free tier the
# only option is qwen/qwen3.8-27b — the llama models are Enterprise-gated.
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# Local chat fallback, used when GROQ_API_KEY is blank.
AI_LOCAL_CHAT_MODEL=qwen2.5:3b-instruct

# Overrides the choice above. Set to `ollama` to force the local chat model even
# when a Groq key is present in the environment.
AI_CHAT_PROVIDER=

