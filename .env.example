POSTGRES_DB=YOUR_VALUE_HERE
POSTGRES_USER=YOUR_VALUE_HERE
POSTGRES_PASSWORD=YOUR_VALUE_HERE



# ── Redis ───────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Google ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_VALUE_HERE
GOOGLE_CLIENT_SECRET=YOUR_VALUE_HERE

# ── Github ───────────────────────────────────────────────────────
GITHUB_CLIENT_ID=YOUR_VALUE_HERE
GITHUB_CLIENT_SECRET=YOUR_VALUE_HERE

# ── SMTP (GMAIL) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_VALUE_HERE
SMTP_PASSWORD=YOUR_VALUE_HERE


MAIL_FROM=YOUR_VALUE_HERE
BREVO_API_KEY=YOUR_VALUE_HERE
BREVO_SMTP_KEY=YOUR_VALUE_HERE
BREVO_TEMPLATE_ORDER_CONFIRMATION=1
BREVO_TEMPLATE_PAYMENT_SUCCESS=2
BREVO_TEMPLATE_ABANDONED_CART=3
BREVO_TEMPLATE_ADMIN_BROADCAST=4
BREVO_TEMPLATE_ORDER_SHIPPED=5

# Background mail jobs. Leave false to keep both dormant.
# Setting this to true activates two schedulers that have never run before and
# start immediately:
#   AbandonedCartScheduler - hourly, enqueues abandoned-cart reminder emails
#   EmailRetryScheduler    - every 60s, retries queued emails Brevo failed to deliver
# Emails are delivered for real, so opt in per environment on purpose.
MAIL_SCHEDULING_ENABLED=false

# ── Frontend URL ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# ── Cloudinary ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=YOUR_VALUE_HERE
CLOUDINARY_API_KEY=YOUR_VALUE_HERE
CLOUDINARY_API_SECRET=YOUR_VALUE_HERE

PAYMOB_API_KEY=YOUR_VALUE_HERE
PAYMOB_HMAC_SECRET=YOUR_VALUE_HERE
PAYMOB_INTEGRATION_ID=YOUR_VALUE_HERE
PAYMOB_IFRAME_ID=YOUR_VALUE_HERE

# AI features (all default false; enable after indexing the catalog)
AI_ENABLED=false
AI_SEARCH_ENABLED=false
AI_CHATBOT_ENABLED=false

# ── AI embeddings ───────────────────────────────────────────────
# Three ways to run the vector index, and one of them is the default:
#
#   1. Gemini            -> set GEMINI_API_KEY. Preferred hosted provider.
#   2. any OpenAI-compatible vendor -> set EMBEDDING_API_KEY (+ EMBEDDING_BASE_URL,
#      EMBEDDING_MODEL). Works with OpenAI, Together, Fireworks, DeepInfra, a
#      self-hosted vLLM, ...
#   3. keyword-only      -> set none of the above. No EmbeddingModel, no vector
#      store, no local model: the catalogue is searched by keyword and startup
#      logs one line saying so.
#
# Local Ollama is NOT the default and never a silent requirement: it is used only
# when AI_EMBEDDING_PROVIDER=ollama is set explicitly.
#
# Groq cannot be used here: it has no embeddings endpoint. Chat can be Groq;
# embeddings cannot.
GEMINI_API_KEY=

# The generic hosted provider. Blank EMBEDDING_API_KEY means "not this one".
# EMBEDDING_BASE_URL must be the API root that the OpenAI client appends
# /embeddings to. EMBEDDING_DIMENSIONS must match vector_store's vector(768)
# unless the schema is migrated with it — the index fingerprint covers both.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# Only consulted when running the local model (AI_EMBEDDING_PROVIDER=ollama).
# A hosted deployment that runs no local model container should leave this unset.
OLLAMA_BASE_URL=http://localhost:11434

# Chat model. Leave GROQ_API_KEY blank and the assistant runs entirely on local
# Ollama (AI_LOCAL_CHAT_MODEL below): zero configuration, no API key, no network.
# Set it and the chat model moves to Groq instead. The embedding decision above
# is independent of this one in every direction: a Groq key does not select an
# embedding provider, and an embedding key does not move chat off Ollama.
GROQ_API_KEY=
# Must include /v1 — Groq's OpenAI-compatible API lives under /openai/v1.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Must be a NON-reasoning model. The gpt-oss-* models return reasoning_content on every
# assistant turn; Spring AI replays that turn inside the tool-calling loop and Groq rejects
# it with 400, so every tool-backed question answers with the failure apology instead of a
# recommendation. Startup now rejects a reasoning model outright. On Groq's free tier the
# only option is qwen/qwen3.8-27b — the llama models are Enterprise-gated.
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# Local chat fallback, used when GROQ_API_KEY is blank.
AI_LOCAL_CHAT_MODEL=qwen2.5:3b-instruct

# Overrides the choice above. Set to `ollama` to force the local chat model even
# when a Groq key is present in the environment.
AI_CHAT_PROVIDER=

# Overrides the embedding choice above. One of:
#   gemini                        (needs GEMINI_API_KEY)
#   openai-compatible            (needs EMBEDDING_API_KEY, plus EMBEDDING_BASE_URL
#                                  and EMBEDDING_MODEL for any vendor but OpenAI)
#   ollama                        (a local Ollama serving an embedding model — opt-in)
#   none                          (keyword-only search, no vector index)
# Leave it blank to let the keys decide: GEMINI_API_KEY, then EMBEDDING_API_KEY,
# then keyword-only. An unrecognised value is a startup error rather than a silent
# fallback to a provider you did not ask for.
AI_EMBEDDING_PROVIDER=

