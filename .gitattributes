/mvnw text eol=lf
*.cmd text eol=crlf

# Normalize text files to LF in the repository and working tree so that
# CRLF/LF differences do not show up as whole-file modifications.
* text=auto eol=lf

# Binary assets are never line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
